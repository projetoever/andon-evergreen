{
  "product": "ANDON Web Industrial",
  "version": "1.0.0-pilot.3",
  "channel": "pilot",
  "branch": "main",
  "components": {
    "frontend": "1.0.0-pilot.3",
    "backend": "1.0.0-pilot.3",
    "windowsInstaller": "1.0.0-pilot.3",
    "windowsRuntime": "1.0.0-pilot.3"
  },
  "deployment": {
    "currentPilotDatabaseMode": "docker",
    "companyHostPostPilotRecommendation": "local",
    "developmentDatabaseMode": "docker",
    "normalOperation": "local_offline",
    "runtimeOrder": [
      "database",
      "api",
      "frontend",
      "kiosk"
    ]
  },
  "ports": {
    "apiDefault": 3001,
    "frontendDefault": 8080,
    "currentPilotPostgresPort": 5432,
    "companyPostgresRecommendedPort": 5433
  },
  "readiness": [
    "/health",
    "/health/db",
    "/api/machines?includeInactive=true"
  ],
  "database": {
    "engine": "PostgreSQL",
    "migration": "20260716120000_add_call_asset_confirmation",
    "migrationType": "additive",
    "migrationApplied": true,
    "backupRequiredBeforeDeploy": true
  },
  "installationProfiles": {
    "public": [
      "empty",
      "starter",
      "demo"
    ],
    "internalBase": "core",
    "appliesOn": "clean_install_only",
    "runsOnUpdate": false,
    "runsOnRepair": false,
    "recordedIn": "C:\\web-andon-industrial\\andon-config.json"
  },
  "automaticHealthTest": {
    "origin": "installer_health_check",
    "isSystemTest": true,
    "historyLabel": "Teste automático",
    "excludedFromOperationalIndicators": true
  }
}
