{
  "name": "andon-evergreen-server",
  "version": "1.0.0-pilot.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test:auth": "node --import tsx --test src/security/technicianCredentials.test.ts",
    "test:dashboard": "node --import tsx --test ../tests/dashboardPriority.test.ts",
    "test:impact": "TSX_TSCONFIG_PATH=../tsconfig.json node --import tsx --test ../tests/callImpactAttribution.test.ts ../tests/failureDescriptionUtils.test.ts",
    "test:ui": "TSX_TSCONFIG_PATH=../tsconfig.json node --import tsx --test ../tests/virtualKeyboardUtils.test.ts",
    "test:installer": "node --import tsx --test src/installerPreservation.test.ts",
    "test:integration": "node scripts/validate-pr-flow.mjs",
    "test:plc": "node --import tsx --test src/integrations/plc/plcFoundation.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev --name init",
    "db:seed": "prisma db seed",
    "db:seed:empty": "tsx prisma/seed.ts --profile=empty",
    "db:seed:starter": "tsx prisma/seed.ts --profile=starter",
    "db:seed:demo": "tsx prisma/seed.ts --profile=demo",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@prisma/client": "^6.19.0",
    "fastify": "^5.6.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "prisma": "^6.19.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
