generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SystemSettings {
  id                                                   String   @id @default("global")
  clientName                                           String   @default("Evergreen") @db.VarChar(100)
  clientUnit                                           String   @default("") @db.VarChar(100)
  hubEnabled                                           Boolean  @default(false)
  requireWorkstationApproval                           Boolean  @default(false)
  allowWholeSetCalls                                   Boolean  @default(true)
  virtualKeyboardEnabled                               Boolean  @default(true)
  requireWorkOrderAtOpen                               Boolean  @default(false)
  restrictMaintenanceCompletionToAttendanceWorkstation Boolean  @default(false)
  dashboardSoundMuteTimerEnabled                       Boolean  @default(false)
  dashboardSoundMuteDurationMinutes                    Int      @default(3)
  dashboardSoundAutoMuteTimerEnabled                   Boolean  @default(false)
  dashboardSoundActiveDurationMinutes                  Int      @default(3)
  dashboardSoundMuted                                  Boolean  @default(false)
  dashboardSoundMutedAt                                DateTime?
  dashboardSoundMutedUntil                             DateTime?
  dashboardSoundMuteReason                             String?
  dashboardMachineOrderMode                            String   @default("default")
  attendanceMode                                       String   @default("name")
  rfidReaderMode                                       String   @default("keyboard_hid")
  rfidInputTerminator                                  String   @default("enter")
  rfidCodeLength                                       Int?
  filterTechniciansByCurrentShift                      Boolean  @default(true)
  andonVisualPalette                                   Json     @default("{}")
  andonVisualPaletteRevision                           Int      @default(0)
  adminPasswordHash                                    String?
  adminRecoveryCodeHash                                String?
  adminRecoveryCodeIssuedAt                            DateTime?
  createdAt                                            DateTime @default(now())
  updatedAt                                            DateTime @updatedAt

  @@map("system_settings")
}


model DashboardPriorityConfig {
  id                 String    @id @default("global")
  managerUsername    String?
  managerPasswordHash String?
  passwordRequired   Boolean   @default(true)
  lastOrderUpdatedAt DateTime?
  lastOrderUpdatedBy String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("dashboard_priority_config")
}

model Workstation {
  id                 String              @id
  name               String?
  pendingApproval Boolean @default(false)
  active             Boolean             @default(true)
  allowOperational   Boolean             @default(true)
  allowBi            Boolean             @default(true)
  allowPriorities    Boolean             @default(true)
  lastIpAddress      String?             @db.VarChar(45)
  lastSeenAt         DateTime            @default(now())
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  accessSessions     AccessSession[]
  admission          WorkstationAdmission?
  technicianSessions TechnicianSession[]
  soundPreferences   WorkstationMachineSoundPreference[]
  lockedMachineId    String?

  @@index([active])
  @@index([lastSeenAt])
  @@map("workstations")
}

model ModuleCredential {
  id                String   @id
  username          String?
  passwordHash      String?
  passwordRequired  Boolean  @default(false)
  credentialVersion Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("module_credentials")
}

model AndonCategory {
  id                        String                    @id
  displayName               String
  categoryGroup             String
  color                     String
  active                    Boolean                   @default(true)
  displayOrder              Int                       @default(0)
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  technicianTechnicalAreas  TechnicianTechnicalArea[]

  @@index([active])
  @@index([displayOrder])
  @@map("andon_categories")
}

model Machine {
  id                  String                   @id
  name                String
  machineStatus       String                   @default("running")
  andonStatus         String                   @default("normal")
  productionMode      String                   @default("scheduled")
  requireWorkOrderAtOpen Boolean                @default(false)
  isActive            Boolean                  @default(true)
  displayOrder        Int?
  priorityOrder       Int?
  currentCallId       String?                  @unique
  currentCall         AndonCall?               @relation("MachineCurrentCall", fields: [currentCallId], references: [id], onDelete: SetNull)
  lastStatusChangedAt DateTime                 @default(now())
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  andonCalls          AndonCall[]              @relation("MachineAndonCalls")
  machineSets         MachineSet[]
  technicianSessions  TechnicianSession[]
  failureEvents       FailureEvent[]
  callImpactIntervals CallImpactInterval[]
  productionEvents    MachineProductionEvent[]
  priorityHistory     MachinePriorityHistory[]
  accessUsers         AccessMachine[]
  kioskDevices        KioskDevice[]
  workstationSoundPreferences WorkstationMachineSoundPreference[]

  @@map("machines")
}

model WorkstationMachineSoundPreference {
  workstationId String
  machineId     String
  enabled       Boolean     @default(true)
  workstation  Workstation @relation(fields: [workstationId], references: [id], onDelete: Cascade)
  machine      Machine     @relation(fields: [machineId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@id([workstationId, machineId])
  @@index([machineId])
  @@map("workstation_machine_sound_preferences")
}

model MachinePriorityHistory {
  id                   String   @id @default(cuid())
  machineId            String
  machine              Machine  @relation(fields: [machineId], references: [id], onDelete: Restrict)
  previousOrder        Int?
  newOrder             Int?
  previousPriorityRank Int?
  newPriorityRank      Int?
  changedAt            DateTime @default(now())
  changedBy            String?
  source               String   @default("priority_manager")
  reason               String?
  createdAt            DateTime @default(now())

  @@index([machineId])
  @@index([changedAt])
  @@index([machineId, changedAt])
  @@index([newPriorityRank])
  @@map("machine_priority_history")
}

model MachineSetType {
  id           String       @id @default(cuid())
  code         String       @unique
  name         String
  description  String?
  isActive     Boolean      @default(true)
  displayOrder Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  machineSets  MachineSet[]

  @@index([isActive])
  @@index([displayOrder])
  @@map("machine_set_types")
}

model MachineSubsetType {
  id             String          @id @default(cuid())
  code           String          @unique
  name           String
  description    String?
  isActive       Boolean         @default(true)
  displayOrder   Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  machineSubsets MachineSubset[]

  @@index([isActive])
  @@index([displayOrder])
  @@map("machine_subset_types")
}

model MachineSet {
  id           String          @id @default(cuid())
  machineId    String
  machine      Machine         @relation(fields: [machineId], references: [id], onDelete: Restrict)
  code         String
  name         String
  type         String?
  typeId       String?
  setType      MachineSetType? @relation(fields: [typeId], references: [id], onDelete: SetNull)
  description  String?
  isActive     Boolean         @default(true)
  displayOrder Int?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  andonCalls          AndonCall[] @relation("AndonCallOpeningMachineSet")
  confirmedAndonCalls AndonCall[] @relation("AndonCallConfirmedMachineSet")
  subsets      MachineSubset[]

  @@unique([machineId, code])
  @@index([machineId])
  @@index([type])
  @@index([typeId])
  @@map("machine_sets")
}

model MachineSubset {
  id           String            @id @default(cuid())
  machineSetId String
  machineSet   MachineSet        @relation(fields: [machineSetId], references: [id], onDelete: Restrict)
  typeId       String?
  subsetType   MachineSubsetType? @relation(fields: [typeId], references: [id], onDelete: SetNull)
  code         String
  name         String
  description  String?
  manufacturer String?
  model        String?
  assetTag     String?
  isActive     Boolean           @default(true)
  displayOrder Int?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  andonCalls          AndonCall[] @relation("AndonCallOpeningMachineSubset")
  confirmedAndonCalls AndonCall[] @relation("AndonCallConfirmedMachineSubset")
  @@unique([machineSetId, code])
  @@index([machineSetId])
  @@index([typeId])
  @@index([assetTag])
  @@index([isActive])
  @@map("machine_subsets")
}

model AndonCall {
  id                          String                      @id @default(cuid())
  machineId                   String
  machine                     Machine                     @relation("MachineAndonCalls", fields: [machineId], references: [id], onDelete: Restrict)
  currentForMachine           Machine?                    @relation("MachineCurrentCall")
  machineSetId                 String?
  machineSet                   MachineSet?    @relation("AndonCallOpeningMachineSet", fields: [machineSetId], references: [id], onDelete: SetNull)
  machineSetCodeSnapshot       String?
  machineSetNameSnapshot       String?
  machineSetTypeSnapshot       String?
  machineSubsetId              String?
  machineSubset                MachineSubset? @relation("AndonCallOpeningMachineSubset", fields: [machineSubsetId], references: [id], onDelete: SetNull)
  machineSubsetCodeSnapshot    String?
  machineSubsetNameSnapshot    String?
  machineSubsetTypeSnapshot          String?

  confirmedMachineSetId              String?
  confirmedMachineSet                MachineSet?    @relation("AndonCallConfirmedMachineSet", fields: [confirmedMachineSetId], references: [id], onDelete: SetNull)
  confirmedMachineSetCodeSnapshot    String?
  confirmedMachineSetNameSnapshot    String?
  confirmedMachineSetTypeSnapshot    String?

  confirmedMachineSubsetId           String?
  confirmedMachineSubset             MachineSubset? @relation("AndonCallConfirmedMachineSubset", fields: [confirmedMachineSubsetId], references: [id], onDelete: SetNull)
  confirmedMachineSubsetCodeSnapshot String?
  confirmedMachineSubsetNameSnapshot String?
  confirmedMachineSubsetTypeSnapshot String?

  assetConfirmedAt                   DateTime?
  assetConfirmedBy                   String?
  assetLocationChanged               Boolean        @default(false)
  assetChangeReason                  String?
  category                    String
  subtype                     String?
  workOrderNumber             String?
  operatorNote                String?
  status                      String
  criticality                 String
  machineCondition            String?
  openedAt                    DateTime
  attendedAt                  DateTime?
  currentAttendanceStartedAt  DateTime?
  maintenanceCompletedAt      DateTime?
  finishedAt                  DateTime?
  technicianName              String?
  technicianNames             String[]                    @default([])
  technicianArea              String?
  callWaitingMinutes          Int?
  attendanceMinutes           Float?
  postMaintenanceMinutes      Float?
  totalCallMinutes            Int?
  machineStoppedMinutes       Int?
  impactTrackingVersion       Int?
  maintenanceReturnCount      Int                         @default(0)
  cancelReason                String?
  notes                       String?
  failureClassification       String?
  failureDescription          String?
  failureResponsibility       String?
  analyticsDisposition        String?
  createdBy                   String?
  origin                      String                      @default("kiosk")
  isSystemTest                Boolean                     @default(false)
  productionModeAtOpen        String?
  productionModeAtAttend      String?
  productionModeAtFinish      String?
  machineStatusAtOpen         String?
  machineStatusAtAttend       String?
  machineStatusAtFinish       String?
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt
  technicianSessions          TechnicianSession[]
  technicianTimeAllocations   TechnicianTimeAllocation[]
  failureEvents               FailureEvent[]
  impactIntervals             CallImpactInterval[]

  @@index([machineId])
  @@index([machineSetId])
  @@index([machineSubsetId])
  @@index([confirmedMachineSetId])
  @@index([confirmedMachineSubsetId])
  @@index([assetConfirmedAt])
  @@index([status])
  @@index([isSystemTest])
  @@index([openedAt])
  @@map("andon_calls")
}

model TechnicianSession {
  id                    String     @id @default(cuid())
  callId                String
  call                  AndonCall  @relation(fields: [callId], references: [id], onDelete: Cascade)
  machineId             String
  machine               Machine    @relation(fields: [machineId], references: [id], onDelete: Restrict)
  technicianId          String?
  technician            Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  technicianName        String
  technicalArea         String?
  shiftId               String?
  shift                 Shift?     @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  shiftName             String?
  workstationId         String?
  workstation           Workstation? @relation(fields: [workstationId], references: [id], onDelete: SetNull)
  phase                 String?
  cycleIndex            Int?
  startedAt             DateTime
  endedAt               DateTime?
  endReason             String?
  notes                 String?
  productionModeAtStart String?
  machineStatusAtStart  String?
  productionModeAtEnd   String?
  machineStatusAtEnd    String?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@index([callId])
  @@index([machineId])
  @@index([technicianId])
  @@index([workstationId])
  @@index([callId, phase, endedAt])
  @@map("technician_sessions")
}

model TechnicianTimeAllocation {
  id             String    @id @default(cuid())
  callId         String
  call           AndonCall @relation(fields: [callId], references: [id], onDelete: Cascade)
  technicianName String
  technicianId   String?
  technician     Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  startedAt      DateTime
  endedAt        DateTime?
  totalSeconds   Int?
  source         String
  createdAt      DateTime  @default(now())

  @@index([callId])
  @@index([technicianId])
  @@map("technician_time_allocations")
}

model FailureEvent {
  id              String     @id @default(cuid())
  machineId       String
  machine         Machine    @relation(fields: [machineId], references: [id], onDelete: Restrict)
  callId          String?
  call            AndonCall? @relation(fields: [callId], references: [id], onDelete: SetNull)
  startedAt       DateTime
  endedAt         DateTime?
  durationSeconds Int?
  classification  String?
  failureResponsibility String?
  analyticsDisposition String?
  source          String
  productionMode  String?
  machineStatus   String?
  notes           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([machineId])
  @@index([callId])
  @@index([startedAt])
  @@map("failure_events")
}

model CallImpactInterval {
  id               String    @id @default(cuid())
  callId           String
  call             AndonCall @relation(fields: [callId], references: [id], onDelete: Cascade)
  machineId        String
  machine          Machine   @relation(fields: [machineId], references: [id], onDelete: Restrict)
  startedAt        DateTime
  endedAt          DateTime?
  durationSeconds  Int?
  source           String
  assignedByCallId String?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([callId])
  @@index([machineId])
  @@index([callId, endedAt])
  @@index([machineId, endedAt])
  @@index([startedAt])
  @@map("call_impact_intervals")
}

model MachineProductionEvent {
  id              String    @id @default(cuid())
  machineId       String
  machine         Machine   @relation(fields: [machineId], references: [id], onDelete: Cascade)
  productionMode  String
  startedAt       DateTime
  endedAt         DateTime?
  durationSeconds Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([machineId])
  @@index([startedAt])
  @@map("machine_production_events")
}

model Technician {
  id                         String                     @id @default(cuid())
  employeeId                 String?                    @unique
  name                       String
  technicalArea              String?
  shiftId                    String?
  shift                      Shift?                     @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  active                     Boolean                    @default(true)
  pinHash                    String?
  tagHash                    String?
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  technicianSessions         TechnicianSession[]
  technicianTimeAllocations  TechnicianTimeAllocation[]
  technicalAreas             TechnicianTechnicalArea[]

  @@index([shiftId])
  @@map("technicians")
}

model TechnicianTechnicalArea {
  technicianId String
  technicalArea String
  technician   Technician    @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  category     AndonCategory @relation(fields: [technicalArea], references: [id], onDelete: Restrict)

  @@id([technicianId, technicalArea])
  @@index([technicalArea])
  @@map("technician_technical_areas")
}

model Shift {
  id                  String                @id
  name                String
  startTime           String
  endTime             String
  active              Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  technicians         Technician[]
  technicianSessions  TechnicianSession[]

  @@map("shifts")
}

model FailureClassification {
  id        String   @id @default(cuid())
  label     String
  value     String   @unique
  active    Boolean  @default(true)
  responsibility String @default("unassigned")
  analyticsDisposition String @default("include")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("failure_classifications")
}

model KioskDevice {
  id               String   @id @default(cuid())
  name             String
  ipAddress        String?
  location         String?
  defaultMachineId String?
  defaultMachine   Machine? @relation(fields: [defaultMachineId], references: [id], onDelete: SetNull)
  lastHeartbeat    DateTime?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([defaultMachineId])
  @@map("kiosk_devices")
}

model FailureDiagnosisAudit {
  id                     String   @id @default(cuid())
  callId                 String?
  failureEventId         String?
  machineId              String
  technicianId           String
  technicianName         String
  workstationId          String?
  ipAddress              String?  @db.VarChar(45)
  previousClassification String?
  newClassification      String?
  previousResponsibility String?
  newResponsibility String?
  previousDisposition String?
  newDisposition String?
  previousDescription    String?
  newDescription         String?
  createdAt              DateTime @default(now())

  @@index([callId, createdAt])
  @@index([failureEventId, createdAt])
  @@index([machineId, createdAt])
  @@map("failure_diagnosis_audit")
}

// Central access foundation. Provisioning/activation UI is delivered separately.
model AccessUser {
  id                      String   @id @default(cuid())
  login                   String   @unique
  displayName             String
  roleLabel               String
  accountType             String   @default("person")
  active                  Boolean  @default(true)
  isPrimaryAdmin          Boolean  @default(false)
  machineScope            String   @default("selected")
  passwordHash            String
  mustChangePassword      Boolean  @default(true)
  temporaryExpiresAt      DateTime?
  temporaryConsumedAt     DateTime?
  authorizationVersion    Int      @default(1)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  permissions             AccessPermission[]
  machines                AccessMachine[]
  sessions                AccessSession[]
  admissionRequests       WorkstationAdmission[] @relation("WorkstationAdmissionRequester")
  admissionDecisions      WorkstationAdmission[] @relation("WorkstationAdmissionDecider")

  @@map("access_users")
}

model WorkstationAdmission {
  id                String   @id @default(cuid())
  workstationId     String   @unique
  workstation       Workstation @relation(fields: [workstationId], references: [id], onDelete: Restrict)
  requesterUserId   String
  requester         AccessUser @relation("WorkstationAdmissionRequester", fields: [requesterUserId], references: [id], onDelete: Restrict)
  requestedName     String?
  requestReason     String?
  requestIpAddress  String? @db.VarChar(45)
  status            String @default("pending")
  requestedAt       DateTime @default(now())
  decidedAt         DateTime?
  decidedByUserId   String?
  decidedBy         AccessUser? @relation("WorkstationAdmissionDecider", fields: [decidedByUserId], references: [id], onDelete: Restrict)
  decisionReason    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status, requestedAt])
  @@index([requesterUserId, requestedAt])
  @@index([decidedByUserId, decidedAt])
  @@map("workstation_admissions")
}

model AccessPermission {
  userId String
  key    String
  user   AccessUser @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([userId, key])
  @@map("access_permissions")
}

model AccessMachine {
  userId    String
  machineId String
  user      AccessUser @relation(fields: [userId], references: [id], onDelete: Restrict)
  machine   Machine @relation(fields: [machineId], references: [id], onDelete: Restrict)

  @@id([userId, machineId])
  @@index([machineId])
  @@map("access_machines")
}

model AccessSession {
  id                   String @id @default(cuid())
  tokenHash            String @unique
  userId               String
  workstationId        String
  purpose              String
  authorizationVersion Int
  createdAt            DateTime @default(now())
  lastInteractionAt    DateTime @default(now())
  expiresAt            DateTime
  revokedAt            DateTime?
  user                 AccessUser @relation(fields: [userId], references: [id], onDelete: Restrict)
  workstation          Workstation @relation(fields: [workstationId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@index([workstationId, revokedAt])
  @@index([expiresAt])
  @@map("access_sessions")
}

model IndustrialServiceIdentity {
  id              String   @id @default(cuid())
  name            String   @unique
  active          Boolean  @default(true)
  scopes          String[]
  secretHash      String
  secretVersion   Int      @default(1)
  secretExpiresAt DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  revokedAt       DateTime?
  sessions        IndustrialServiceSession[]

  @@index([active, secretExpiresAt])
  @@map("industrial_service_identities")
}

model IndustrialServiceSession {
  id            String   @id @default(cuid())
  tokenHash     String   @unique
  serviceId     String
  secretVersion Int
  createdAt     DateTime @default(now())
  expiresAt     DateTime
  lastUsedAt    DateTime @default(now())
  revokedAt     DateTime?
  service       IndustrialServiceIdentity @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([serviceId, revokedAt])
  @@index([expiresAt])
  @@map("industrial_service_sessions")
}

model AuditEvent {
  id              String @id @default(cuid())
  occurredAt      DateTime @default(now())
  actorType       String
  actorUserId     String?
  actorLogin      String?
  actorName       String?
  actorRole       String?
  workstationId   String?
  sessionId       String?
  ipAddress       String? @db.VarChar(45)
  requestId       String?
  action          String
  resourceType    String
  resourceId      String?
  machineId       String?
  result          String
  reason          String?
  before          Json?
  after           Json?
  schemaVersion   Int @default(1)

  @@index([occurredAt, id])
  @@index([actorUserId, occurredAt])
  @@index([resourceType, resourceId, occurredAt])
  @@index([machineId, occurredAt])
  @@map("audit_events")
}
